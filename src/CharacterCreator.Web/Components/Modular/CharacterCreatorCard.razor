@using CharacterCreator.Web.Models
@inject IHttpClientFactory HttpClientFactory
<div class="character-card">
    <input class="character-input" type="text" placeholder="CHARACTER NAME" @bind="character.Name"/>
    <select class="character-input" name="species">
        @foreach (var species in allSpecies)
        {
            <option @bind="character.SpeciesId" value="@species.Id">@species.Name</option>
        }
    </select>
    <select class="character-input" name="characterClass">
        @foreach (var c in allCharacterClasses)//c is characterclass
        {
            <option @bind="character.ClassId" value="@c.Id">@c.Name</option>
        }
    </select>
    <select class="character-input" name="background">
        @foreach (var c in allBackgrounds)//c is characterclass
        {
            <option @bind="character.BackgroundId" value="@c.Id">@c.Name</option>
        }
    </select>
    <div>
        <button onclick="@SaveCharacter">save</button>    
    </div>
</div>

<style>
    .character-card {
        background-color: #d4b8b4;
        padding: 20px;
        border-radius: 5px;
        height: 480px;
        width: 300px;
    }
    .character-input {
        margin: 0px 10px;
        width: 200px;
        color: black;
    }
</style>
@code {
    private Character character = new Character();
    private List<Species> allSpecies = new List<Species>();
    private List<Background> allBackgrounds = new List<Background>();
    private List<CharacterClass> allCharacterClasses = new List<CharacterClass>();

    protected override async Task OnInitializedAsync()
    {
        await LoadListsAsync();
    }

    private async Task LoadListsAsync()
    {
        var client = HttpClientFactory.CreateClient("Api");
        allSpecies = await client.GetFromJsonAsync<List<Species>>("api/species") ?? new List<Species>();
        allBackgrounds = await client.GetFromJsonAsync<List<Background>>("api/background") ?? new List<Background>();
        allCharacterClasses = await client.GetFromJsonAsync<List<CharacterClass>>("api/characterclass") ?? new List<CharacterClass>();
    }

    private async Task SaveCharacter()
    {
        var client = HttpClientFactory.CreateClient("Api");
        await client.PostAsJsonAsync("api/characters/create", character);
    }
}